# GenericAI wrapper runtime config.  (plain key = value; '#' comments; NOT XML)
#
# Accepted "on" values for every switch: 1 / true / yes / on  (anything else = off).
# All default OFF and are independent. Errors/failures are ALWAYS shown regardless.
# No rebuild needed: edit this file next to the GenericAI executable and restart it.
#
# show_debug        -> host verbose console output: HTTP server state, SetParameters
#                      echo, "Detected!!" / "Recognized:" lines, and the
#                      "[ZMQ result] zmq_send OK/FAILED ..." line at the send point.
# show_native_debug -> native informational console logs: [MotionDetector],
#                      [PersonDetector], [AI], [channel], [zmq] lines.
# log_to_file       -> persist INFO/WARN/ERROR to a file (independent of the console
#                      switches above):
#                        <log dir>/GenericAI-<basePort>.log
#                        <log dir>/error-<basePort>.log
# log_dir           -> Linux only. Log directory; when unset: $GENERICAI_LOG_DIR,
#                      then /var/log/spark/GenericAI, then <exe dir>/Logs
#                      (first one that can be created and written).

show_debug = 0
show_native_debug = 0
log_to_file = 0
# log_dir = /var/log/spark/GenericAI

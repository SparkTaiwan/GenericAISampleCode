# GenericAI wrapper runtime config.
#
# show_debug = 1  -> print all verbose console output (HTTP server state,
#                    SetParameters echo, detection/send results, "Detected!!" /
#                    "Recognized:" lines). Handy for debugging.
# show_debug = 0  -> quiet (default). Errors/failures are ALWAYS shown regardless.
#
# No rebuild needed: edit this file next to GenericAI.exe and restart the process.
show_debug = 0
